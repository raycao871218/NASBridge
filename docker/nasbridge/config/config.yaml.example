app:
  name: NASBridge
  public_base_url: "http://nas-ip:18080"

# Existing wechat-article-reader HTTP service (server-side requests, no CORS needed).
wechat_reader:
  base_url: "http://host.docker.internal:18765"

mihomo:
  url: "http://host.docker.internal:9090"
  secret_env: "MIHOMO_SECRET"
  timeout_seconds: 3

applications:
  - id: qbittorrent
    name: "qBittorrent"
    expected_mode: proxy
    source_ips: ["127.0.0.1"]
    process_contains: ["qbittorrent"]
    qbt_config: "/host/qbittorrent/qBittorrent.conf"

# Optional: restricted SSH forced-command key for the existing daily service.
# See ops/DAILY_TASK_CONTROL.md. Keep real host/key values in local config only.
# daily_task_control:
#   ssh_host: "192.0.2.20"
#   ssh_user: "task-user"
#   ssh_key_path: "/app/config/daily-task-id_ed25519"
#   ssh_known_hosts: "/app/config/daily-task-known_hosts"
# Optional: auto-issue missing reverse-proxy certificates with Certbot DNS-01.
# The Cloudflare credential file and Certbot plugin must exist on the Nginx host.
# reverse_proxy:
#   auto_certificate:
#     zones: ["example.com"]
#     cloudflare_credentials: "/root/.secrets/certbot/cloudflare.ini"
certificates:
  local:
    - id: nas_cert
      name: "NAS certificate"
      path: "/host/certs/example/fullchain.pem"
      domain: "example.com"
  remote:
    - id: remote_https
      name: "Remote HTTPS certificate"
      host: "203.0.113.10"
      port: 443
      server_name: "example.com"
      local_ref: "nas_cert"
      sync_enabled: false
      ssh_host: "203.0.113.10"
      ssh_user: "root"
      ssh_port: 22
      ssh_key_path: "/root/.ssh/id_ed25519"
      ssh_known_hosts: "/root/.ssh/known_hosts"
      remote_cert_path: "/etc/nginx/ssl/fullchain.pem"
      remote_key_path: "/etc/nginx/ssl/privkey.pem"
      remote_backup_dir: "/var/backups/nasbridge"

zerotier:
  # Optional link to your controller UI; keep the actual address in local config.
  admin_url: ""
# Codex CLI account switcher (optional; see ops/CODEX_ACCOUNTS.md).
# codex_accounts:
#   ssh_host: "10.10.0.172"
#   ssh_user: "caobowen"
#   ssh_key_path: "/app/config/codex-account-id_ed25519"
#   ssh_known_hosts: "/app/config/codex-account-known-hosts"
