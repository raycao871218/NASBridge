# Copy to .env. Never commit actual credentials.
NASBRIDGE_POSTGRES_HOST=host.docker.internal
NASBRIDGE_POSTGRES_PORT=5432
NASBRIDGE_POSTGRES_DATABASE=nasbridge
NASBRIDGE_POSTGRES_USER=nasbridge
NASBRIDGE_POSTGRES_PASSWORD=
MIHOMO_SECRET=
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=

# Absolute paths on the Docker host; replace these examples before deploying.
NASBRIDGE_RHINO_MEDIA=/path/to/rhino-media
NASBRIDGE_MIHOMO_DIR=/path/to/mihomo
NASBRIDGE_CERT_DIR=/path/to/certificates
NASBRIDGE_QBITTORRENT_CONFIG=/path/to/qBittorrent.conf
NASBRIDGE_SSH_DIR=/path/to/ssh
NASBRIDGE_DOMAINS_CONFIG=../../domains_config.yaml

# Optional build-time proxies (do not configure credentials in source).
NASBRIDGE_BUILD_HTTP_PROXY=
NASBRIDGE_BUILD_HTTPS_PROXY=
NASBRIDGE_BUILD_ALL_PROXY=

# Optional HTTP proxy used only for map place searches (never sent to browsers).
NASBRIDGE_GEOCODING_PROXY=
